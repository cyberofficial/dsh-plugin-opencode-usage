{
  "name": "dsh-plugin-opencode-usage",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode usage in the DSH Web composer dock — rolling, weekly and monthly quota rows under the chat input",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:build": "node scripts/build-client.mjs --check",
    "test": "npm run check:build && node test/usage.test.mjs && node test/host.test.mjs && node test/client-bundle.test.mjs"
  },
  "devDependencies": {
    "react": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
